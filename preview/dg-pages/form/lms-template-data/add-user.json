        "isSelect": true,
        "options": ["UTC-12", "UTC-11", "UTC-10", "UTC-9", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+4", "UTC+5", "UTC+6", "UTC+7", "UTC+8", "UTC+9", "UTC+10", "UTC+11", "UTC+12"],
        "required": true
      },
      {
        "id": "profilePic",
        "label": "Profile Picture",
        "name": "profilePic",
        "type": "file",
        "isImage": true,
        "required": false
      },
      {
        "id": "bio",
        "label": "Bio",
        "name": "bio",
        "type": "textarea",
        "placeholder": "Write a short bio about the user",
        "required": false
      },
      {
        "id": "enrollmentStatus",
        "label": "Enrollment Status",
        "name": "enrollmentStatus",
        "isSelect": true,
        "options": ["Active", "Pending", "Suspended"],
        "required": true
      }
    ]
