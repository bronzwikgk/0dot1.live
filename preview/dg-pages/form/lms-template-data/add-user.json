        "isSelect": true,
        "options": ["Student", "Instructor", "Admin"],
        "required": true
      },
      {
        "id": "gender",
        "label": "Gender",
        "name": "gender",
        "isSelect": true,
        "options": ["Male", "Female", "Other"],
        "required": false
      },
      {
        "id": "dob",
        "label": "Date of Birth",
        "name": "dob",
        "type": "date",
        "required": false
      },
      {
        "id": "country",
        "label": "Country",
        "name": "country",
