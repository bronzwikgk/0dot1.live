{
    "formId": "add-user-form",
    "inputs": [
      {
        "id": "fullName",
        "label": "Full Name",
        "name": "fullName",
        "type": "text",
        "placeholder": "Enter full name",
        "required": true
      },
      {
        "id": "email",
        "label": "Email Address",
        "name": "email",
        "type": "email",
        "placeholder": "Enter email address",
        "required": true
      },
      {
        "id": "phone",
        "label": "Phone Number",
        "name": "phone",
        "type": "tel",
        "placeholder": "Enter phone number",
        "required": true
      },
      {
        "id": "password",
        "label": "Password",
        "name": "password",
        "type": "password",
        "placeholder": "Enter password",
        "required": true
      },
      {
        "id": "confirmPassword",
        "label": "Confirm Password",
        "name": "confirmPassword",
        "type": "password",
        "placeholder": "Re-enter password",
        "required": true
      },
      {
